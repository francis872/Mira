{
  "ConnectionStrings": {
    "PostgreSql": "Host=<TU_DB_HOST>;Port=<TU_DB_PORT>;Database=<TU_DB_NAME>;Username=<TU_DB_USER>;Password=<TU_DB_PASSWORD>"
  },
  "JwtSettings": {
    "Key": "<TU_SECRETO_JWT>",
    "Issuer": "MIRA_Api",
    "Audience": "MIRA_Client",
    "DurationInMinutes": 480
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
