# Valores de ejemplo: sustituir todos los secretos antes del despliegue.
POSTGRES_DB=mira_db
POSTGRES_USER=mira_user
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5544
API_PORT=8081
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__PostgreSql=Host=mira-postgres;Port=5432;Database=mira_db;Username=mira_user;Password=change_me_local_only

# Generar un secreto aleatorio de 32 bytes o más; nunca publicar el valor real.
Jwt__Secret=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG
Jwt__Issuer=MIRA.Api
Jwt__Audience=MIRA.Client
# Secret Flask (debe ser aleatorio en producción).
SECRET_KEY=REPLACE_WITH_RANDOM_FLASK_SECRET
