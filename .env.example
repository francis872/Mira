# Copie este archivo a .env y reemplace TODOS los valores marcados con REPLACE. No versione .env.
POSTGRES_DB=mira_db
POSTGRES_USER=mira_user
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Puertos del equipo anfitrión (cambie alguno si ya está ocupado).
POSTGRES_PORT=5544
API_PORT=8081
FRONTEND_PORT=5000

ASPNETCORE_ENVIRONMENT=Development

# Clave aleatoria externa para JWT; genere 32 bytes o más con un generador criptográfico.
JWT_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Clave DIFERENTE de JWT_KEY/SECRET_KEY para autenticar el origen Flask → API.
LOGIN_FORWARDING_KEY=REPLACE_WITH_A_DIFFERENT_32_BYTE_RANDOM_KEY
# Vacío por defecto. Solo CIDR de proxies que realmente controlen/sobrescriban X-Forwarded-For.
MIRA_TRUSTED_PROXY_NETWORKS=

# Perfil existente Docker/local: filesystem con directorio privado persistente.
# Vercel: postgres + MIRA_PLATFORM=vercel y conexión privada VerifyFull/Channel Binding.
MIRA_SESSION_BACKEND=filesystem
MIRA_SESSION_DATABASE_URL=
MIRA_PLATFORM=

# Clave estable de Flask para producción; el JWT permanece en el servidor.
# Si se deja vacía, Flask genera una al arrancar y los formularios abiertos antes de un reinicio deben recargarse.
SECRET_KEY=

# true solo si Flask se sirve por HTTPS.
SESSION_COOKIE_SECURE=false
