# Ejemplo de configuración de entorno para MIRA (sin secretos reales)
POSTGRES_DB=mira_db
POSTGRES_USER=<TU_DB_USER>
POSTGRES_PASSWORD=<TU_DB_PASSWORD>
POSTGRES_PORT=5544

# Configuración de la API REST
API_PORT=8081
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
JWT_SECRET=<TU_SECRETO_JWT_MINIMO_32_CARACTERES>

# Cadena de conexión inyectada por variable de entorno a MIRA.Api
ConnectionStrings__PostgreSql=Host=mira-postgres;Port=5432;Database=mira_db;Username=<TU_DB_USER>;Password=<TU_DB_PASSWORD>
