# Copie este archivo a .env y reemplace TODOS los valores marcados con REPLACE. No versione .env.
POSTGRES_DB=mira_db
POSTGRES_USER=mira_user
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Puertos del equipo anfitrión (cambie alguno si ya está ocupado).
POSTGRES_PORT=5544
API_PORT=8081
FRONTEND_PORT=5000

ASPNETCORE_ENVIRONMENT=Development

# Clave aleatoria externa para JWT; genere 32 bytes o más con un generador criptográfico.
JWT_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Clave estable de Flask para producción; el JWT permanece en el servidor.
# Si se deja vacía, Flask genera una al arrancar y los formularios abiertos antes de un reinicio deben recargarse.
SECRET_KEY=

# true solo si Flask se sirve por HTTPS.
SESSION_COOKIE_SECURE=false
