# Ejemplo revisable, NO aplicado. Crear estos recursos tendría coste.
# Una sola instancia frontend; el disco debe ser escribible por UID 10001.
services:
  - type: web
    name: mira-api-v3
    runtime: docker
    branch: feature/mira-v3
    dockerfilePath: ./Dockerfile
    dockerContext: .
    plan: starter
    numInstances: 1
    autoDeployTrigger: "off"
    healthCheckPath: /health
    envVars:
      - key: ASPNETCORE_ENVIRONMENT
        value: Production
      - key: PORT
        value: "10000"
      - key: ConnectionStrings__PostgreSql
        sync: false
      - key: Jwt__Key
        sync: false
      - key: Jwt__Issuer
        value: MIRA
      - key: Jwt__Audience
        value: MIRA.Frontend
      - key: Jwt__Minutes
        value: "20"
  - type: web
    name: mira-frontend-v3
    runtime: docker
    branch: feature/mira-v3
    dockerfilePath: ./frontend/Dockerfile
    dockerContext: ./frontend
    plan: starter
    numInstances: 1
    autoDeployTrigger: "off"
    healthCheckPath: /health
    disk:
      name: mira-sessions
      mountPath: /var/lib/mira/sessions
      sizeGB: 1
    envVars:
      - key: PORT
        value: "10000"
      - key: MIRA_ENV
        value: production
      - key: SECRET_KEY
        sync: false
      - key: API_URL
        sync: false
      - key: SESSION_COOKIE_SECURE
        value: "true"
      - key: SESSION_DIRECTORY
        value: /var/lib/mira/sessions
      - key: WEB_CONCURRENCY
        value: "1"
